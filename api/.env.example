# Copy this file to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=
# Small, cheap model by default
OPENAI_MODEL=gpt-4o-mini
# Signs chat session tokens. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Postgres connection URL. For local work use Railway's PUBLIC address (see README).
DATABASE_URL=
# From the Clerk dashboard (API keys): the secret key, starts with sk_test_
CLERK_SECRET_KEY=
# Website(s) allowed to call the dashboard API (comma separated)
DASHBOARD_ORIGIN=http://localhost:3001
PORT=3000
