# Copy this file to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=
# Small, cheap model by default
OPENAI_MODEL=gpt-4o-mini
# Signs chat session tokens. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Postgres connection URL. For local work use Railway's PUBLIC url (DATABASE_PUBLIC_URL).
DATABASE_URL=
PORT=3000
